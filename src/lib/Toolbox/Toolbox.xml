    <category name="Events" colour="#fc6">
        <block type="events_loaded" />
        <sep gap="48"></sep>
        <block type="events_thread" />
        <sep gap="48"></sep>
        <block type="events_whenflagclicked" />
        <block type="events_whenkeypressed" />
        <block type="events_whenspriteclicked" />
        <block type="events_whenbackdropswitches" />
        <block type="events_whengreaterthan" />
        <block type="events_whenclonestarts" />
        <sep gap="48"></sep>
        <block type="events_regbroadcast" />
        <block type="events_broadcast" />
        <block type="events_broadcastw" />
    </category>
    <category name="Control" colour="#fb6">
        <block type="control_wait" />
        <block type="control_waitF" />
        <block type="control_waitU" />
        <sep gap="48"></sep>
        <block type="control_if" />
        <block type="control_if">
            <mutation else="1" />
        </block>
        <sep gap="48"></sep>
        <block type="control_repeat" />
        <block type="control_while" />
        <sep gap="48"></sep>
        <block type="control_return" />
        <block type="control_inline">
            <statement name="BLOCKS">
                <block type="control_return" />
            </statement>
        </block>
    </category>
    <category name="Math" colour="#6d6">
        <block type="math_number" />
        <block type="math_boolean" />
        <sep gap="48"></sep>
        <block type="math_add" />
        <block type="math_sub" />
        <block type="math_mul" />
        <block type="math_div" />
        <block type="math_pow" />
        <block type="math_mod" />
        <block type="math_log" />
        <sep gap="48"></sep>
        <block type="math_random" />
        <sep gap="48"></sep>
        <block type="math_const" />
        <sep gap="48"></sep>
        <block type="math_true" />
        <block type="math_false" />
        <block type="math_randombool" />
        <sep gap="48"></sep>
        <block type="math_and" />
        <block type="math_xor" />
        <block type="math_or" />
        <block type="math_not" />
        <sep gap="48"></sep>
        <block type="math_equals" />
        <block type="math_gt" />
        <block type="math_gte" />
        <block type="math_lt" />
        <block type="math_lte" />
    </category>
    <category name="Strings" colour="#6db">
        <block type="strings_string" />
        <sep gap="48"></sep>
        <block type="strings_join">
            <mutation items="2" />
        </block>
        <block type="strings_repeat" />
        <block type="strings_substring" />
        <block type="strings_split" />
        <block type="strings_length" />
        <block type="strings_contains" />
        <block type="strings_amountof" />
        <block type="strings_replace" />
        <sep gap="48"></sep>
        <block type="strings_log" />
        <sep gap="48"></sep>
        <block type="strings_json_stringify" />
        <block type="strings_json_getproperty" />
        <block type="strings_json_setproperty" />
        <block type="strings_json_isvalid" />
    </category>
    <category name="Vectors" colour="#6cd">
        <block type="vector_create" />
        <sep gap="48"></sep>
        <block type="vector_x" />
        <block type="vector_y" />
    </category>
    <category name="Sensors" colour="#69d">
        <block type="inputs_touching" />
        <block type="inputs_touchingsprite" />
        <block type="inputs_touchingcolor" />
        <sep gap="48"></sep>
        <block type="inputs_distancemouse" />
        <block type="inputs_distancesprite" />
        <sep gap="48"></sep>
        <block type="inputs_ask" />
        <block type="inputs_answer" />
        <sep gap="48"></sep>
        <block type="inputs_keypress" />
        <block type="inputs_keyspressed" />
        <sep gap="48"></sep>
        <block type="inputs_mousex" />
        <block type="inputs_mousey" />
        <block type="inputs_moused" />
        <block type="inputs_setdrag" />
        <block type="inputs_draggable" />
        <sep gap="48"></sep>
        <block type="inputs_timer" />
        <block type="inputs_resettimer" />
        <sep gap="48"></sep>
        <block type="inputs_current" />
        <block type="inputs_dayssince2000" />
        <sep gap="48"></sep>
        <block type="inputs_username" />
        <block type="inputs_loudness" />
    </category>
    <category name="Variables" colour="#f96" custom="variables">
        <!-- resources/categories/variables.js -->
    </category>
    <category name="Lists" colour="#f76">
        <block type="lists_create">
            <mutation items="3" />
        </block>
        <block type="lists_create">
            <mutation items="0" />
        </block>
        <sep gap="48"></sep>
        <block type="lists_get" />
        <block type="lists_index" />
        <block type="lists_length" />
        <block type="lists_contains" />
        <sep gap="48"></sep>
        <block type="lists_set" />
        <block type="lists_join" />
        <block type="lists_concat" />
        <sep gap="48"></sep>
        <block type="lists_foreach">
            <value name="INDEX">
                <shadow type="lists_foreachindex" />
            </value>
            <value name="VALUE">
                <shadow type="lists_foreachvalue" />
            </value>
        </block>
    </category>
    <category name="Lambdas" colour="#d46">

    </category>
    <category name="Blocks" colour="#b6f" custom="blocks">
        <!-- resources/categories/blocks.js -->
    </category>

    <sep />

